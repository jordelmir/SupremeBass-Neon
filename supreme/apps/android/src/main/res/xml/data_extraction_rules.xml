<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup: only non-sensitive settings -->
    <cloud-backup>
        <include domain="sharedpref" path="audio_state.xml" />
        <include domain="sharedpref" path="app_settings.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <!-- Device transfer: slightly broader but still exclude sensitive data -->
    <device-transfer>
        <include domain="sharedpref" path="audio_state.xml" />
        <include domain="sharedpref" path="app_settings.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
